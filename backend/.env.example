# ============================================================
# MÔI TRƯỜNG ỨNG DỤNG
# ============================================================
NODE_ENV=development
PORT=3000
# Địa chỉ frontend (CORS + cookie đăng nhập). Frontend chạy `npm run dev` ở cổng 3001
FRONTEND_URL=http://localhost:3001

# Tên ứng dụng (hiển thị trong email và Swagger)
APP_NAME=Hệ thống Quản lý Lao động

# ============================================================
# CƠ SỞ DỮ LIỆU POSTGRESQL
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=12345678
DB_NAME=quan_ly_lao_dong
# ⚠️ CẢNH BÁO: Chỉ bật DB_SYNC=true ở môi trường development!
# Tắt ở production, dùng migration thay thế.
DB_SYNC=true

# ============================================================
# JWT AUTHENTICATION
# ============================================================
# 🔑 QUAN TRỌNG: Thay bằng secret ngẫu nhiên dài tối thiểu 32 ký tự!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-please
JWT_EXPIRES_IN=8h

# ============================================================
# CẤU HÌNH EMAIL (SMTP)
# ============================================================
# Ví dụ sử dụng Gmail:
# 1. Bật "2-Step Verification" trong tài khoản Google
# 2. Vào: Manage Google Account > Security > App passwords
# 3. Tạo App Password và điền vào MAIL_PASS bên dưới
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=testmail@gmail.com
# Để trống khi dev: email (kèm mã OTP) được in ra console của backend thay vì gửi đi
MAIL_PASS=

# ============================================================
# FILE TẢI LÊN (hồ sơ đăng ký doanh nghiệp)
# ============================================================
UPLOAD_DIR=uploads
